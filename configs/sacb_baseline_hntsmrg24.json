{
  "schema_version": 1,
  "experiment_name": "sacb_baseline_hntsmrg24",
  "seed": 2026,
  "data": {
    "cohort": "HNTS-MRG24 longitudinal T2",
    "shape_dhw": [128, 160, 160],
    "spacing_dhw": [1.5, 1.5, 1.5],
    "moving_timepoint": "raw preRT after rigid/affine prealignment",
    "fixed_timepoint": "midRT",
    "labels_for_training": false
  },
  "model": {
    "architecture": "sacb",
    "in_channels": 1,
    "channel_scale": 4,
    "num_k": [7, 7, 7, 7],
    "fix_kmeans_rng": true,
    "kmeans_max_iter": 20,
    "kmeans_tolerance": 0.0001,
    "mean_type": "s",
    "scale": 1.0
  },
  "loss": {
    "similarity": 1.0,
    "smoothness": 0.3,
    "ncc_window": 9
  },
  "optimization": {
    "epochs": 500,
    "batch_size": 1,
    "workers": 4,
    "learning_rate": 0.0001,
    "weight_decay": 0.00001,
    "warmup_epochs": 5,
    "minimum_lr_factor": 0.05,
    "gradient_clip": 5.0,
    "amp": true,
    "amp_initial_scale": 1024.0,
    "amp_growth_interval": 2000,
    "allow_tf32": true,
    "validate_every": 1,
    "checkpoint_every": 25,
    "log_every": 10
  }
}
